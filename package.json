{
  "name": "muzikazmodelmarket",
  "version": "1.0.0",
  "private": true,
  "description": "MUZIKAZ WORLD connected creative universe.",
  "scripts": {
    "build": "npm run build:voices && node scripts/build-static.mjs",
    "start": "node server.mjs",
    "check": "node scripts/check-static.mjs",
    "test": "node --test test/*.test.mjs",
    "build:land-data": "python3 scripts/build-land-database.py",
    "check:land-data": "python3 scripts/build-land-database.py --check",
    "static": "python3 -m http.server 4173 --directory dist",
    "optimize:environment": "node scripts/optimize-environment.mjs",
    "check:environments": "node scripts/check-environments.mjs",
    "build:asset-registry": "node scripts/build-game-asset-registry.mjs",
    "export:graphics": "python3 scripts/export-graphics-pack.py",
    "check:asset-registry": "node scripts/build-game-asset-registry.mjs --check",
    "build:voices": "node scripts/prepare-neural-voices.mjs"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "onnxruntime-node": "1.23.2",
    "phonemizer": "1.2.1"
  }
}
